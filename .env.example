# Copy to `.env` (repo root or apps/api) for local development. Never commit real values.

# ---- Backend (FastAPI) ----
# Local default is SQLite. For Supabase use the SESSION POOLER URL (port 5432, user postgres.<project-ref>):
# DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=sqlite:///./careloop.db
# Optional. Without it the app uses deterministic templates (demo still fully works).
GROQ_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile
# Long random string; required by POST /internal/tick (header X-Cron-Token).
CRON_TOKEN=change-me-to-a-long-random-string
# Comma-separated exact origins allowed by CORS.
ALLOWED_ORIGINS=http://localhost:3000
DEMO_MODE=true
# Directory with trained artifacts (xgb.joblib, calibrator.joblib, cox.joblib, metrics.json, seed.json).
MODEL_DIR=../../ml/artifacts
LOG_LEVEL=INFO

# ---- Frontend (Next.js, apps/web/.env.local) ----
NEXT_PUBLIC_API_URL=http://localhost:7860
